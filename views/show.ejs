            <ul>
              <li>Name: <%= user.name %></li>
              <li>Dept: <%= user.dept %></li>
              <li>Salary: &#8377;<%= user.salary.toLocaleString("en-IN") %></li>
            </ul>
          </div>
        </div>
        <% } %>
