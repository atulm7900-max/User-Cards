      <div class="add-post">
        <form method="post" action="/users">
          <h1 class="col-12">Add Your Card</h1>
          <div class="row col-10">
            <div class="col-12 mb-3">
              <label class="form-label">Name</label>
              <input class="form-control" type="text" placeholder="abc" name="name" />
            </div>
            <div class="col-12 mb-3">
              <label class="form-label">Department</label>
              <input class="form-control" type="text" name="dept" placeholder="BCA" />
            </div>
            <div class="col-12 mb-3">
              <label class="form-label">Salary</label>
              <input type="number" placeholder="10000" class="form-control" name="salary" />
            </div>
            <div class="col-12 mb-3">
              <button class="btn btn-dark">Add</button>
            </div>
          </div>
        </form>
      </div>

    </div>
