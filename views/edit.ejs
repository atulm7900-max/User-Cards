<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1>You Are About Edit <%= user.name %></h1>
    <form method="post" action="/users/<%= user._id %>?_method=PATCH">
      <input
        type="text"
        value="<%= user.name %>"
        placeholder="Enter Name"
        name="name"
      /><br /><br />
      <input
        type="text"
        value="<%= user.dept %>"
        placeholder="Enter Department"
        name="dept"
      /><br /><br />
      <input
        type="number"
        value="<%= user.salary %>"
        placeholder="Enter Salary"
        name="salary"
      /><br /><br />
      <button>Edit</button>
    </form>
  </body>
</html>
